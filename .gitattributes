# Normalize text in Git and use consistent LF endings in working trees.
* text=auto eol=lf

# Use CRLF endings for Windows command scripts.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shader sources are text.
*.vert text
*.frag text
*.glsl text

# Keep binary assets out of text conversion and text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
